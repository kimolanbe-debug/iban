<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IBAN Paylaşım Servisi</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }
    .card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 28px 24px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }
    h2 {
      color: #f8fafc;
      font-size: 20px;
      margin-bottom: 20px;
      text-align: center;
    }
    .input-group {
      margin-bottom: 14px;
      text-align: left;
    }
    label {
      display: block;
      color: #94a3b8;
      font-size: 13px;
      margin-bottom: 6px;
    }
    input {
      width: 100%;
      background: #0f172a;
      border: 1px solid #334155;
      color: #f8fafc;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      outline: none;
    }
    input:focus {
      border-color: #38bdf8;
    }
    .btn {
      background: #2563eb;
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 14px;
      width: 100%;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-top: 8px;
    }
    .btn:active {
      transform: scale(0.98);
    }
    .btn.copied {
      background: #16a34a;
    }
    .btn-secondary {
      background: #334155;
      color: #cbd5e1;
      margin-top: 10px;
    }
    .result-box {
      margin-top: 18px;
      display: none;
    }
    .iban-box {
      background: #0f172a;
      border: 1px solid #334155;
      padding: 14px 10px;
      border-radius: 10px;
      color: #38bdf8;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.5px;
      word-break: break-all;
      margin-bottom: 14px;
      text-align: center;
    }
    .name-display {
      color: #f8fafc;
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 16px;
      text-align: center;
    }
    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <!-- 1. Link Oluşturma Arayüzü -->
  <div class="card" id="generator-card">
    <h2>IBAN Linki Oluştur</h2>
    
    <div class="input-group">
      <label>Alıcı Ad Soyad</label>
      <input type="text" id="input-name" placeholder="Örn: Ahmet Yılmaz">
    </div>

    <div class="input-group">
      <label>IBAN Numarası</label>
      <input type="text" id="input-iban" placeholder="TR00 0000 0000 0000 0000 0000 00">
    </div>

    <button class="btn" onclick="generateLink()">Link Üret</button>

    <div class="result-box" id="result-box">
      <div class="input-group">
        <label>Paylaşılabilir Link:</label>
        <input type="text" id="generated-url" readonly>
      </div>
      <button class="btn btn-secondary" id="copy-link-btn" onclick="copyLink()">Linki Kopyala</button>
    </div>
  </div>

  <!-- 2. Alıcının Göreceği Kopyalama Kartı -->
  <div class="card hidden" id="viewer-card">
    <div style="color: #94a3b8; font-size: 13px; text-align: center; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">Alıcı Bilgileri</div>
    <div class="name-display" id="view-name"></div>
    
    <div class="iban-box" id="view-iban"></div>
    
    <button class="btn" id="copy-iban-btn" onclick="copyIBAN()">IBAN'ı Kopyala</button>
    <button class="btn btn-secondary" onclick="window.location.href = window.location.pathname">Yeni Link Oluştur</button>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const paramName = params.get('name');
    const paramIban = params.get('iban');

    const generatorCard = document.getElementById('generator-card');
    const viewerCard = document.getElementById('viewer-card');

    // Eğer link parametreyle açılmışsa gösterim moduna geç
    if (paramIban) {
      generatorCard.classList.add('hidden');
      viewerCard.classList.remove('hidden');

      document.getElementById('view-name').textContent = paramName || 'Banka Hesabı';
      document.getElementById('view-iban').textContent = paramIban;
    }

    function generateLink() {
      const name = encodeURIComponent(document.getElementById('input-name').value.trim());
      const iban = encodeURIComponent(document.getElementById('input-iban').value.trim());

      if (!iban) {
        alert('Lütfen en azından bir IBAN girin.');
        return;
      }

      const fullUrl = `${window.location.origin}${window.location.pathname}?name=${name}&iban=${iban}`;
      document.getElementById('generated-url').value = fullUrl;
      document.getElementById('result-box').style.display = 'block';
    }

    function copyLink() {
      const linkInput = document.getElementById('generated-url');
      navigator.clipboard.writeText(linkInput.value).then(() => {
        const btn = document.getElementById('copy-link-btn');
        btn.textContent = 'Link Kopyalandı! ✓';
        setTimeout(() => { btn.textContent = 'Linki Kopyala'; }, 2000);
      });
    }

    function copyIBAN() {
      const cleanIban = (paramIban || '').replace(/\s+/g, '');
      navigator.clipboard.writeText(cleanIban).then(() => {
        const btn = document.getElementById('copy-iban-btn');
        btn.textContent = 'IBAN Kopyalandı! ✓';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = "IBAN'ı Kopyala";
          btn.classList.remove('copied');
        }, 2000);
      });
    }
  </script>

</body>
</html>
